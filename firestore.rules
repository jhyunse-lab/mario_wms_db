rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Memos collection security rules
    match /memos/{memoId} {
      allow read, write: if true;
    }

    // Test server master data (출고/거래처 갱신 데이터)
    match /test_system_master/{docId} {
      allow read, write: if true;
    }

    // Production server master data (출고/거래처 갱신 데이터)
    match /prod_system_master/{docId} {
      allow read, write: if true;
    }

    // Legacy system_master
    match /system_master/{docId} {
      allow read, write: if true;
    }
  }
}
